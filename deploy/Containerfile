# Reference Containerfile for voxcpm2-openai (engine + app in one container).
# Mirrors the qwen3-tts-openai layout: s6-overlay supervises the vLLM-Omni engine
# (internal port) and the FastAPI app (port 8000).
#
# Engine stack:
#   - vllm/vllm-omni:v0.32.0 ships vLLM 0.32.0 + vLLM-Omni 0.32.0, ffmpeg, curl, uv
#   - VoxCPM2 support needs the upstream `voxcpm` package (2.0.3 tested)
#   - s6-overlay is copied from the proven qwen3 base image (same Ubuntu 24.04 layout)
#     because the upstream vLLM image has no supervisor
#
# The upstream image has no s6-overlay; take the installed v3 tree from the image this
# project already ran in production rather than re-downloading it at build time.
FROM harbor.dotslash.io/dotslash/qwen3-tts-openai:1.4.3 AS s6
FROM docker.io/vllm/vllm-omni:v0.32.0

COPY --from=s6 /command /command
COPY --from=s6 /package /package
COPY --from=s6 /etc/s6-overlay /etc/s6-overlay
COPY --from=s6 /init /init

RUN uv pip install --system --break-system-packages --no-cache voxcpm==2.0.3

# vLLM-Omni 0.32 already reads VoxCPM2 CFG/diffusion steps from
# hf_overrides.voxcpm2_runtime_config, so this backport of PR #7010 is a no-op; it stays
# to fail loudly if a future base image regresses and to document the knob wiring.
COPY deploy/patches/voxcpm2_runtime_knobs.py /tmp/voxcpm2_runtime_knobs.py
RUN python3 /tmp/voxcpm2_runtime_knobs.py && rm /tmp/voxcpm2_runtime_knobs.py

# Sanity checks at build time (fail the build if the stack drifted)
RUN python3 -c "import vllm, vllm_omni; assert vllm.__version__.startswith('0.32'), vllm.__version__; assert vllm_omni.__version__.startswith('0.32'), vllm_omni.__version__" 2>/dev/null \
 && pip show nvidia-nccl-cu13 | grep -q '^Version: 2.30.7' \
 && python3 -c "from voxcpm.core import VoxCPM" 2>/dev/null

# trust_remote_code writes to the HF modules cache; keep it off the read-only /models mount.
ENV HF_HOME=/var/cache/hf \
    HF_HUB_OFFLINE=1 \
    DATA_DIR=/data \
    MODEL_PATH=/models/openbmb/VoxCPM2 \
    ENGINE_PORT=8102 \
    DEPLOY_CONFIG=/opt/app/deploy/voxcpm2-3090.yaml \
    S6_STAGE2_HOOK=/bin/true \
    S6_BEHAVIOUR_IF_STAGE2_FAILS=1

# App-only runtime deps (match pyproject.toml). Install with --no-deps and list their runtime
# deps explicitly: a dependency resolver could still pull a newer pydantic/numpy transitively and
# silently break the engine stack (wave-2 review). soundfile bundles libsndfile; numpy/pydantic
# already come from the proven base. Do NOT add fastapi/uvicorn/httpx/numpy/pydantic here.
# The import check below is the backstop if an explicit dep is missing.
RUN uv pip install --system --break-system-packages --no-cache --no-deps \
    soundfile safetensors python-multipart pydantic-settings python-dotenv

# Fail the build if any runtime import is missing or drifted
RUN python3 -c "import fastapi, uvicorn, httpx, numpy, soundfile, safetensors, pydantic, pydantic_settings, multipart"

# ffmpeg (mp3/opus transcoding, R-016) and curl (compose healthcheck, R-045) are needed at
# runtime. The upstream image already ships both; apt is only a fallback.
RUN (command -v ffmpeg >/dev/null || (apt-get update && apt-get install -y --no-install-recommends ffmpeg && rm -rf /var/lib/apt/lists/*)) \
 && ffmpeg -version >/dev/null && curl --version >/dev/null

# Drop any inherited app/supervisor (absent in the upstream image; kept as a guard).
RUN rm -rf /opt/app

# App (OpenAI API + Studio API + static UI), engine deploy config, and s6-overlay v3
# service definitions: engine = vllm serve on 127.0.0.1:$ENGINE_PORT,
# app = uvicorn on 0.0.0.0:8000 (starts after engine, polls /health + warms up itself).
COPY app/ /opt/app/app/
COPY deploy/voxcpm2-3090.yaml /opt/app/deploy/voxcpm2-3090.yaml
COPY deploy/supported-languages.json /opt/app/deploy/supported-languages.json

# SPEC §5a: the Studio enables languages from this file, so it must ship and parse.
RUN python3 -c "import json; d = json.load(open('/opt/app/deploy/supported-languages.json')); assert len(d['languages']) == 30, len(d['languages'])"

# Remove inherited service dirs and their user/contents.d markers so the base cannot start
# another engine or double-bind :8000. Then install our two services.
RUN rm -rf /etc/s6-overlay/s6-rc.d/engine /etc/s6-overlay/s6-rc.d/app /etc/s6-overlay/s6-rc.d/qwen3* \
    /etc/s6-overlay/s6-rc.d/user/contents.d/engine \
    /etc/s6-overlay/s6-rc.d/user/contents.d/app \
    /etc/s6-overlay/s6-rc.d/user/contents.d/qwen3*
COPY deploy/s6/ /etc/s6-overlay/s6-rc.d/
RUN chmod +x /etc/s6-overlay/s6-rc.d/engine/run /etc/s6-overlay/s6-rc.d/app/run

# Guard: after our copy, no other service run file may mention qwen3, start a second vllm serve,
# or run a second uvicorn (a base uvicorn service on :8000 would double-bind the app). Ours are
# exactly /etc/s6-overlay/s6-rc.d/{engine,app}/run.
RUN stale=$(grep -RlE 'qwen3|vllm serve|uvicorn' /etc/s6-overlay/s6-rc.d --include=run 2>/dev/null \
      | grep -vE '^/etc/s6-overlay/s6-rc.d/(engine|app)/run$' || true); \
    [ -z "$stale" ] || { echo "stale s6 services: $stale"; exit 1; }

ENTRYPOINT ["/init"]
CMD []
